# ==============================================================================
# Hoodium Faucet — environment template
# ==============================================================================
# Copy to .env and fill in. NEVER commit the real .env: it contains the hot
# dispenser private key.
#
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Network
# ------------------------------------------------------------------------------
# Which Hoodium network this faucet serves: devnet | testnet
#
# MAINNET IS NOT SUPPORTED and will be rejected at startup. A faucet hands out
# tokens with no value; on mainnet those tokens are real money, so serving
# mainnet would be a funds leak rather than a feature.
#
# Chain IDs (from the chain repo's docs/networks.md):
#   devnet  6592 (rune_6592-1)  <- current target
#   testnet 6591 (rune_6591-1)
HOODIUM_NETWORK=devnet

# EVM JSON-RPC endpoint.
# Local node:            http://127.0.0.1:8545
# From inside Docker:    http://host.docker.internal:8545
HOODIUM_RPC_URL=http://127.0.0.1:8545

# ------------------------------------------------------------------------------
# Vault (written by `npm run deploy:devnet` -> contracts/deployments/<net>.json)
# ------------------------------------------------------------------------------
FAUCET_VAULT_ADDRESS=

# Admin/treasurer for the vault at deploy time. Set to a MULTISIG for anything
# beyond a throwaway devnet; leave empty to use the deployer account.
FAUCET_ADMIN_ADDRESS=

# ------------------------------------------------------------------------------
# Dispenser (the backend's hot key — NOT a custody key)
# ------------------------------------------------------------------------------
# This key only holds DISPENSER_ROLE. It cannot mint, withdraw or change policy.
# Generate a dedicated key for the backend; never reuse the deployer/admin key.
#
# Key A — the dispenser key (generate fresh, takes 5 seconds)
# cd ~/faucet/backend && node -e 'const { Wallet } = require("ethers");const w = Wallet.createRandom();console.log("address    :", w.address);console.log("privateKey :", w.privateKey);'
FAUCET_DISPENSER_PRIVATE_KEY=
FAUCET_DISPENSER_ADDRESS=

# ------------------------------------------------------------------------------
# Deploy-time signing keys (Hardhat, run from contracts/)
# ------------------------------------------------------------------------------
# Comma-separated list; only needed for the network you are deploying to.
HOODIUM_DEVNET_PRIVATE_KEY=
HOODIUM_TESTNET_PRIVATE_KEY=

HOODIUM_DEVNET_RPC_URL=http://127.0.0.1:8545
HOODIUM_TESTNET_RPC_URL=

# ------------------------------------------------------------------------------
# Seeding (contracts/scripts/seed-devnet.ts)
# ------------------------------------------------------------------------------
# Native RUNE deposited into the vault at seed time, in whole units.
FAUCET_SEED_NATIVE_RUNE=100

# Set true to deploy MockERC20 tokens, mint supply to the treasury and deposit it
# into the vault. Use on a fresh devnet that has no spendable ERC-20 yet.
FAUCET_SEED_DEPLOY_MOCKS=false

# Optional custom mock list (JSON). Defaults to mUSD + mHOODI when unset.
# FAUCET_SEED_ERC20=[{"name":"Mock USD","symbol":"mUSD","decimals":18,"supply":1000000,"deposit":250000}]

# ------------------------------------------------------------------------------
# Anti-abuse
# ------------------------------------------------------------------------------
# Per-wallet cooldown in seconds. The vault enforces its own cooldown too; this
# value is the off-chain mirror used for fast rejection.
CLAIM_COOLDOWN_SECONDS=86400

# Per-IP claim budget. Raise only if you know many legitimate users share a NAT.
IP_MAX_CLAIMS=5
IP_WINDOW_SECONDS=86400

# ------------------------------------------------------------------------------
# CAPTCHA — set a provider before exposing the faucet publicly
# ------------------------------------------------------------------------------
# none | turnstile | recaptcha
CAPTCHA_PROVIDER=none
# Server-side secret. Never exposed to the browser.
CAPTCHA_SECRET_KEY=
# Public site key, sent to the browser so the widget can render. Required
# whenever CAPTCHA_PROVIDER is not "none".
CAPTCHA_SITE_KEY=

# ------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# Comma-separated allowed origins. "*" allows all (development only).
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Priority fee added on top of the base fee, in gwei.
GAS_PRIORITY_FEE_GWEI=1
# Optional fixed gas limit per dispense; 0 = estimate.
GAS_LIMIT=0

# Number of reverse-proxy hops to trust for X-Forwarded-For. Set 0 when the API
# is directly internet-facing.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# Frontend / compose
# ------------------------------------------------------------------------------
# Host port for the frontend container.
FRONTEND_PORT=8080
