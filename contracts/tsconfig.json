{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["./hardhat.config.ts", "./scripts", "./test", "./typechain-types", "./deploy"],
  "exclude": ["node_modules", "dist", "artifacts", "cache"]
}
