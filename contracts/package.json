{
  "name": "@hoodium-io/faucet-contracts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "FaucetVault + devnet test tokens for the Hoodium Network faucet.",
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean && rm -rf cache artifacts typechain-types",
    "reset": "rm -rf node_modules package-lock.json",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:devnet": "hardhat run scripts/deploy.ts --network hoodiumDevnet",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network hoodiumTestnet",
    "seed:devnet": "hardhat run scripts/seed-devnet.ts --network hoodiumDevnet",
    "add-token:devnet": "hardhat run scripts/add-token.ts --network hoodiumDevnet",
    "grant-dispenser:devnet": "hardhat run scripts/grant-dispenser.ts --network hoodiumDevnet",
    "status:devnet": "hardhat run scripts/inspect-vault.ts --network hoodiumDevnet",
    "fund-dispenser:devnet": "hardhat run scripts/fund-dispenser.ts --network hoodiumDevnet",
    "verify:abi": "hardhat run scripts/verify-abi.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  },
  "overrides": {
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "keccak@3.0.4": true,
    "secp256k1@4.0.5": true
  }
}
